{
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(css|js|assets|./)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "dist/browser"
}
